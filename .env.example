# Copy this file to .env and set a private signing key of at least 32 characters.
# Generate a key with `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
SECRET_KEY=

# For Docker deployment, set this to the named Cloudflare Tunnel connector token.
TUNNEL_TOKEN=

# To export the settings from your completed .env in Bash, run these commands.
# set -a
# source ./.env
# set +a
